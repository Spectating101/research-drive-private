  "signal_rules": [
    {
      "id": "floor_compounder_support_rsi",
      "school_ids": ["idx_retail_playbook", "decuan_macro", "astronacci_gema"],
      "turn_type": "floor",
      "name_type_filter": ["compounder"],
      "conditions": {
        "symbol_scope": "compounders",
        "near_support_60d": true,
        "rsi14_max": 35
      },
      "hold_days": 20,
      "notes": "Data-classified compounders: top-quartile ADV, spike<1%, vol<=p60, at 60d support + RSI<35."
    },
    {
      "id": "floor_bull_divergence",
      "school_ids": ["ihsgscreener", "ajaib_smart_money"],
      "turn_type": "floor",
      "name_type_filter": ["fry", "standard"],
      "conditions": {
        "pos_52w_range_max": 0.55,
        "return_1d_min": 0.03,
        "vol_ratio_20d_min": 2.0
      },
      "hold_days": 5,
      "notes": "IHSG screener bull divergence proxy."
    },
    {
      "id": "floor_event_exhaustion",
      "school_ids": ["sell_side_conditional", "astronacci_gema"],
      "turn_type": "floor",
      "name_type_filter": ["compounder", "standard"],
      "conditions": {
        "in_index_event_window": true,
        "near_support_60d": true,
        "dd_60d_max": -0.08
      },
      "hold_days": 10,
      "notes": "MSCI-style event + support (BBCA Jun 2026 archetype)."
    },
    {
      "id": "floor_regime_banks",
      "school_ids": ["decuan_macro", "idx_retail_playbook", "astronacci_gema"],
      "turn_type": "floor",
      "name_type_filter": ["compounder"],
      "conditions": {
        "ihsg_regime_in": ["washout", "recovery"],
        "symbol_scope": "banks"
      },
      "hold_days": 20,
      "notes": "Index washout/recovery → bank sleeve."
    },
    {
      "id": "floor_quiet_acc",
      "school_ids": ["stockbit_bandarmology", "bandarmology_net", "ajaib_smart_money"],
      "turn_type": "floor",
      "name_type_filter": ["fry", "standard"],
      "conditions": {
        "bandar_lite_label_in": ["quiet_volume_build", "squeeze_from_drawdown"],
        "near_support_40d": true
      },
      "hold_days": 5,
      "notes": "Pre-spike quiet accumulation proxy (bandar_lite)."
    },
    {
      "id": "floor_moon_window",
      "school_ids": ["astronacci_gema"],
      "turn_type": "floor",
      "name_type_filter": ["compounder", "standard", "fry"],
      "conditions": {
        "days_since_new_moon_max": 3,
        "near_support_60d": true
      },
      "hold_days": 14,
      "notes": "Moon trading window — test vs random calendar control."
    },
    {
      "id": "ceiling_ara_streak",
      "school_ids": ["ihsgscreener", "poems_bandarmology"],
      "turn_type": "ceiling",
      "name_type_filter": ["fry"],
      "conditions": {
        "consecutive_ara_days_min": 2,
        "name_type": "fry"
      },
      "hold_days": 5,
      "notes": "Fade after ARA limit hits (short-horizon reward negative = edge)."
    },
    {
      "id": "ceiling_dist_divergence",
      "school_ids": ["poems_bandarmology", "ajaib_smart_money", "stockbit_bandarmology"],
      "turn_type": "ceiling",
      "name_type_filter": ["fry", "standard"],
      "conditions": {
        "return_5d_min": 0.15,
        "vol_ratio_up_down_lt": 0.8,
        "near_resistance_60d": true
      },
      "hold_days": 5,
      "notes": "Price up but volume weaker on up days vs down days."
    },
    {
      "id": "ceiling_markup_trap",
      "school_ids": ["poems_bandarmology"],
      "turn_type": "ceiling",
      "name_type_filter": ["fry", "standard"],
      "conditions": {
        "return_5d_min": 0.25,
        "bandar_lite_label_in": ["chase_into_spike", "momentum_chase"],
        "bandar_lite_label_not_in": ["quiet_volume_build"]
      },
      "hold_days": 5,
      "notes": "Mark-up without prior quiet acc."
    },
    {
      "id": "ceiling_extended_bounce",
      "school_ids": ["astronacci_gema", "sell_side_conditional"],
      "turn_type": "ceiling",
      "name_type_filter": ["compounder", "standard"],
      "conditions": {
        "ihsg_regime_in": ["extended_bounce"],
        "return_5d_min": 0.08
      },
      "hold_days": 10,
      "notes": "Trim chase risk when index extended."
    }
