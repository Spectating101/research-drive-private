{
  "version": 1,
  "created_at": "2026-07-06",
  "source": "ChatGPT assessment + Sharpe-Renaissance data lake inventory (2026-07-06)",
  "role": "Refinitiv is institutional research spine — not another price DB or news duplicate.",
  "ranking_axes": [
    "strategic_value",
    "entitlement_probability",
    "reusable_research_spine",
    "substitute_gap"
  ],
  "core_rule": "Archive what is unique, license-bound, and reusable; query live what is cheap or replaceable.",
  "execution_vs_value": {
    "note": "Execution order (spine first) is not identical to strategic value ranking.",
    "execution_order": "spine → membership → corporate actions → risk tape → fundamentals → estimates → ownership/graph",
    "value_ranking": "PIT membership / PIT fundamentals / vol-skew-SI / estimate revisions / ownership / supply chain"
  },
  "substitutes_already_have": {
    "ohlcv_macro": "data_lake/daily_alpha_panel.csv (yfinance, 13 instruments)",
    "idx_prices": "data_lake/markets/idx_legacy_restore/historical_data.db (648 symbols, 2019-2025)",
    "news_events": "GDELT expanded fleet + derived overlays (66/102 months, ~340GB pipeline)",
    "stablecoin_panel": "data/datasets/stablecoin_trust_engagement/ (20,980 weekly rows)",
    "us_risk_desktop": "From-refinitiv/RESCUED_Full_Market_Data_20251215.csv (S&P graveyard, vol/skew/SI)"
  },
  "tiers": {
    "P0-executable": "High value and plausible from Dec 2025 desktop pull or standard EDP fields",
    "P0-probe": "High value; entitlement uncertain on YZU EDP until Job 0 passes",
    "P1-probe": "Unique but not central; often separate license",
    "P2-thin": "Snapshot or on-demand only",
    "P3-skip": "Wrong lane or duplicate of existing lake"
  },
  "universes": {
    "global_liquid_core": {
      "description": "2,000–3,000 liquid names: US, TW, JP, KR, SG, ID, major ADRs",
      "config_tbd": "config/refinitiv_universes.json"
    },
    "us_graveyard_then_asia": {
      "description": "S&P 500 current + historical graveyard first; then .TWII, .N225, .KS11, .STI, .JKSE if entitled",
      "pit_query_pattern": "0#.SPX(YYYYMMDD)"
    },
    "us_risk_sleeve": {
      "description": "S&P + delisted names for vol/skew/SI; best proven edge from RESCUED pull"
    },
    "asia_research_sleeve": {
      "description": "IDX, TWSE, KRX, TSE, SGX — YZU/Asia identity",
      "seed_config": "config/markets/asia_yfinance_universes.json"
    },
    "macro_cross_asset_sleeve": {
      "description": "Indices, ETFs, FX, commodities — joins and controls only; no bulk price hoard",
      "reference": "config/refinitiv_harvest_plan.json p2_global_backbone"
    },
    "liquid_covered_names": {
      "description": "Names with analyst coverage for estimate revision history"
    }
