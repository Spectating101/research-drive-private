# Copy to ~/.config/research-drive/front-door.env on the Optiplex.
# Keep the real file outside git and chmod 600 it.

# Public UI authority checkout and exact approved release SHA.
# Never copy a historical SHA from an old release document. Set this to the
# frontend commit explicitly paired with the backend candidate being staged.
YZU_PUBLIC_REPO=/absolute/path/to/yzu-cluster
YZU_PUBLIC_SHA=replace-with-approved-frontend-sha

# Bind only to the Optiplex Tailscale address for the internal release.
YZU_DESK_HOST=100.x.y.z
YZU_DESK_PORT=8765
YZU_DESK_SERVE_UI=true
# Optional override; default is ${YZU_PUBLIC_REPO}/dist in the launcher.
# YZU_DESK_STATIC_DIR=/absolute/path/to/yzu-cluster/dist

# Keep unset for the same-origin internal release. A future gateway may set one
# exact http(s) origin; wildcard CORS is rejected.
# YZU_DESK_CORS_ORIGIN=https://future-gateway.example

# Canonical private registry. Relative values resolve from private repo root.
# For a split front-door checkout + runtime-integration store, point this at the
# runtime authority file (or symlink drive/config/research_query_registry.json to it)
# so promotions from windows workers appear in Library/query without receipt_only drift.
SHARPE_REGISTRY_PATH=drive/config/research_query_registry.json

# When set, link_front_door_host_config.sh also binds registry + data_lake/procured
# (and data_lake/yzu_cluster if missing) to this runtime drive root.
# YZU_RUNTIME_DRIVE_ROOT=/absolute/path/to/Sharpe-Renaissance-runtime-integration/drive

# Required to protect every research-data and operations API. Generate a strong
# random value. Rotating it revokes all browser sessions.
YZU_DESK_ACCESS_TOKEN=replace-with-secret

# Internal browser convenience only. The host must be the exact Tailscale bind;
# it may mint a session only for a same-origin request. Never put a public host
# or tunnel hostname here.
DESK_SESSION_BOOTSTRAP_HOSTS=100.x.y.z

# Optional public research desk. This is a separate, limited identity tier:
# each same-origin browser receives a unique signed guest session that may
# browse research data and use Ask, but cannot see faculty/operations data or
# submit, approve, or run collection. Keep this unset for a private-only desk.
# Never put this public hostname in DESK_SESSION_BOOTSTRAP_HOSTS.
# DESK_PUBLIC_GUEST_HOSTS=previous.example.edu
# Keep build provenance accurate when publishing the guest desk through a
# named public tunnel. Leave unset for the default Tailscale-only release.
# YZU_DESK_RELEASE_SCOPE=public-guest-same-origin

# Browser and server-side session lifetime (5 minutes to 7 days; default 12h).
DESK_SESSION_MAX_AGE_SECONDS=43200
# Optional multi-user authority. The file contains identity metadata and
# SHA-256 token digests only; never store raw user tokens in it.
# DESK_PRINCIPALS_FILE=/etc/research-drive/desk-principals.json
# Use a dedicated random secret when DESK_PRINCIPALS_FILE is enabled.
# YZU_DESK_SESSION_SIGNING_SECRET=replace-with-a-random-server-secret
DESK_DEFAULT_USER_ID=desk-operator
DESK_DEFAULT_USER_ROLE=operator
# DESK_DEFAULT_USER_EMAIL=researcher@example.edu
# DESK_DEFAULT_USER_NAME=Researcher name

# Deprecated and intentionally ignored for authorization. Origin is not proof
# of identity; do not configure public origins as a session bootstrap mechanism.
# DESK_PUBLIC_ORIGINS=

# Composer provider. "auto" keeps Cursor first when both are configured;
# choose "copilot" to use the sticky GitHub Copilot account pool below.
DESK_COMPOSER_PROVIDER=auto
# Cursor provider (optional when GitHub Copilot is selected).
# CURSOR_API_KEY=replace-with-secret
# GitHub Copilot aliases are operator-approved identities known to the local
# credential launcher. Tokens stay in that launcher's chmod-600 environment;
# never place them in this service file. One account is pinned per desk session.
# DESK_COPILOT_ACCOUNTS=lab-copilot-primary,lab-copilot-secondary
# DESK_COPILOT_LAUNCHER=/absolute/path/to/copilot-rotate
# DESK_COPILOT_STATE_ROOT=/absolute/path/to/private/copilot-session-state
# Real tool-free calls keep runtime truth current without consuming quota every
# few minutes. Defaults: probe every 3 hours; mark observations stale after 4.
# DESK_COMPOSER_PROBE_INTERVAL_SECONDS=10800
# DESK_COMPOSER_HEALTH_TTL_SECONDS=14400
# Optional Synthesis-only read/reason fallback. It receives Research Drive's
# bounded Library grounding but has no MCP tools and cannot mutate platform state.
# Explicit opt-in is required because the research question and candidate titles
# are sent to the configured external model provider.
# DESK_SYNTHESIS_GEMINI_ENABLED=false
# GEMINI_API_KEY=replace-with-valid-gemini-developer-api-key
# DESK_SYNTHESIS_GEMINI_MODEL=gemini-2.5-flash
# TAVILY_API_KEY=replace-with-secret
# DATACITE_EMAIL=replace-if-required

# Python interpreter for the front door. Must provide the selected Composer SDK
# when Composer is enabled. A system python that cannot import/invoke the chosen
# provider is not a valid production configuration even when credentials exist.
YZU_PYTHON_BIN=/absolute/path/to/venv/bin/python

# Worker-control plane is separate (Tailscale :8780). Keep YZU_WORKER_CONTROL_TOKEN
# identical on the controller process and each Windows worker token file, or join returns 401.

# Wall-clock bound for a Composer turn on /library/chat.
# The 40s default is too tight for a grounded turn that actually uses tools:
# observed runs spend >45s just searching Library holdings and checking
# provenance before composing, and get cut off mid-work as "composer timeout".
# 150s leaves room for real tool use while still bounding a hang. The UI shows
# per-step progress during the wait, so the longer bound stays legible.
DESK_CHAT_TIMEOUT_SECONDS=150
