[Unit]
Description=IDX empirical validation backtests (full suite)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@SR_DIR@
Environment=PYTHONPATH=@KERNEL_DIR@:@ALPHA_DIR@:@DRIVE_DIR@:@SR_DIR@
ExecStart=@VENV_PYTHON@ scripts/run_idn_empirical_research.py --force-validation --full-validation
Nice=10
TimeoutStartSec=7200
