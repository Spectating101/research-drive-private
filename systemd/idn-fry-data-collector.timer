[Unit]
Description=Run IDX fry incremental data collector (paced API budget)

[Timer]
# ~3 runs/day UTC — tune IDN_FRY_BG_BROKER_MAX_CALLS to stay inside RapidAPI quota
OnCalendar=*-*-* 03:10:00
OnCalendar=*-*-* 11:10:00
OnCalendar=*-*-* 19:10:00
Persistent=true
RandomizedDelaySec=600
Unit=idn-fry-data-collector.service

[Install]
WantedBy=timers.target
