[Unit]
Description=Sharpe-Renaissance Drive-first crypto landscape protocol history parallel shards
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/phyrexian/Downloads/llm_automation/project_portfolio/Molina-Optiplex/Sharpe-Renaissance
Environment=SHARD_COUNT=4
Environment=SLEEP_SECS=0.35
ExecStart=/home/phyrexian/Downloads/llm_automation/project_portfolio/Molina-Optiplex/Sharpe-Renaissance/scripts/run_crypto_landscape_history_protocol_shards_drive.sh
ExecStartPost=/usr/bin/systemctl --user start news-shock-headline-backfill.service
ExecStartPost=/usr/bin/systemctl --user start news-shock-url-enrichment.service
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=300
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=append:/home/phyrexian/Downloads/llm_automation/project_portfolio/Molina-Optiplex/Sharpe-Renaissance/logs/crypto_landscape_history_backfill/protocol_shards_systemd.log
StandardError=append:/home/phyrexian/Downloads/llm_automation/project_portfolio/Molina-Optiplex/Sharpe-Renaissance/logs/crypto_landscape_history_backfill/protocol_shards_systemd.log

[Install]
WantedBy=default.target
