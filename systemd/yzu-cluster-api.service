[Unit]
Description=YZU Cluster research API (procurement chat backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@SR_DIR@
Environment=PYTHONPATH=@KERNEL_DIR@:@ALPHA_DIR@:@DRIVE_DIR@:@SR_DIR@
ExecStart=@VENV_PYTHON@ -m scripts.research_query_engine.server --host 127.0.0.1 --port 8765 --serve-ui
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
