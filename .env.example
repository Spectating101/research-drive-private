# Local credentials and API keys.
# Copy to .env on this machine only. Do not commit real values.

# LSEG / Refinitiv — pick ONE path:

# Web / university login (no desktop) — EDP API app key from Manage Applications
LSEG_SESSION_NAME=platform.ldp
LSEG_EDP_APP_KEY=
LSEG_USERNAME=
LSEG_PASSWORD=

# Desktop Workspace/Eikon on same machine — Eikon Data API app key
LSEG_APP_KEY=
EIKON_APP_KEY=

# RapidAPI — Indonesia Stock Exchange (IDX) by yasimpratama88
# https://rapidapi.com/yasimpratama88/api/indonesia-stock-exchange-idx
RAPIDAPI_KEY=

# Reddit OAuth (optional — public fetch often 403; OAuth unlocks r/finansial etc.)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SharpeRenaissanceIDX/1.0 (research)

# BigQuery USDT catalogue (optional)
GOOGLE_CLOUD_PROJECT=

# LunarCrush API v4 — topic/coin time-series requires Individual plan (~$72/mo); free key alone returns HTTP 402
LUNARCRUSH_API_KEY=

# Mobile bulk cache (Transcend USB). Canonical data lives on GDrive — see docs/STORAGE_ARCHITECTURE.md
# RESEARCH_BULK_ROOT=/media/phyrexian/Transcend/sharpe-renaissance

# Cursor SDK — desk chat brain (Composer 2.5 + research MCP). Get key from Cursor dashboard.
CURSOR_API_KEY=
# DESK_BRAIN=cursor_composer | deepseek_legacy
DESK_BRAIN=cursor_composer
# DESK_SETTING_SOURCES=project  (Cursor rules/AGENTS.md — same as IDE agent)
DESK_SETTING_SOURCES=project
DESK_COMPOSER_MODEL=composer-2.5
DESK_COMPOSER_TIMEOUT=180
