+def _query_int(query: dict[str, str], key: str, default: int) -> int:
+    raw = query.get(key)
+    if raw in (None, ""):
+        return default
+    try:
+        return int(raw)
+    except (TypeError, ValueError):
+        return default
+
+
+def _full_flag(query: dict[str, str]) -> bool:
+    return query.get("full", "").lower() in {"1", "true", "yes"}
